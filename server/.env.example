PORT=5001
# Local development only. docker-compose.prod.yml overrides MONGODB_URI (mongo container, or ATLAS_MONGODB_URI with docker-compose.atlas.yml).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/inkofbaphomet?retryWrites=true&w=majority

# Required, at least 32 characters in production (the server refuses to start otherwise): openssl rand -hex 48
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=Ink of Baphomet
CONTACT_EMAIL=

GEMINI_API_KEY=
GEMINI_MODEL=

PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

